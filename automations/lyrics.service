[Unit]
Description=Fetch missing lyrics for music library
After=network.target

[Service]
Type=oneshot
User=saunalserver
WorkingDirectory=/home/saunalserver/projects/tidal_auto_monitor
# Lyrics fetch disabled - requires additional scripts (fetch-lyrics.sh, process-lyrics.sh)
# Re-enable when those scripts are restored
ExecStart=/bin/echo "Lyrics automation placeholder - scripts not yet restored"
StandardOutput=append:/home/saunalserver/projects/tidal_auto_monitor/logs/lyrics.log
StandardError=append:/home/saunalserver/projects/tidal_auto_monitor/logs/lyrics.log

[Install]
WantedBy=multi-user.target
