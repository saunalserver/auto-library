# Last.fm (scrobble source for monitor.py, discovery, weekly playlist)
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USERNAME=your_lastfm_username_here

# Navidrome (Subsonic API: playlists, rescans, lyrics lookups)
SUBSONIC_USER=your_navidrome_user
SUBSONIC_PASS=your_navidrome_password
#SUBSONIC_URL=http://localhost:4534

# Optional overrides (defaults shown)
#MUSIC_ROOT=/mnt/photos/flac_music
#LIBRARY_MOUNT=/mnt/photos
#NTFY_URL=http://localhost:8093/music
#TIDDL_BINARY=~/.local/bin/tiddl
#TIDDL_PYTHON=~/.local/share/pipx/venvs/tiddl/bin/python
#TIDDL_CONFIG=~/tiddl.json
