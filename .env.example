# Copy to .env (chmod 600) and fill in. ./setup.sh does this interactively.

# Last.fm (scrobble source for monitor.py, discovery, weekly playlist)
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USERNAME=your_lastfm_username_here

# Navidrome (Subsonic API: playlists, rescans, lyrics lookups)
SUBSONIC_USER=your_navidrome_user
SUBSONIC_PASS=your_navidrome_password
#SUBSONIC_URL=http://localhost:4534

# Where the library lives. LIBRARY_MOUNT must be a mountpoint, or every
# automation skips its run (protects against writing into an unplugged drive).
# Leave it empty if the library is not on its own drive.
#MUSIC_ROOT=/mnt/photos/flac_music
#LIBRARY_MOUNT=/mnt/photos

# Navidrome's database is read with `docker exec <container> sqlite3 ...`
#NAVIDROME_CONTAINER=navidrome
#NAVIDROME_DB=/data/navidrome.db

# ntfy: any topic URL (self-hosted or ntfy.sh). The token is only needed if your
# server requires auth; it can also live in ~/.config/ntfy-token.
#NTFY_URL=http://localhost:8093/music
#NTFY_DEDUP_URL=http://localhost:8093/music-dedup
#NTFY_TOKEN=

# tiddl (pipx install tiddl)
#TIDDL_BINARY=~/.local/bin/tiddl
#TIDDL_PYTHON=~/.local/share/pipx/venvs/tiddl/bin/python
#TIDDL_CONFIG=~/tiddl.json
