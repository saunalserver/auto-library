[Unit]
Description=TIDAL Auto-Download Monitor
After=network.target

[Service]
Type=oneshot
User=saunalserver
WorkingDirectory=/home/saunalserver/projects/tidal_auto_monitor
ExecStart=/usr/bin/python3 /home/saunalserver/projects/tidal_auto_monitor/monitor.py
StandardOutput=append:/home/saunalserver/projects/tidal_auto_monitor/logs/systemd.log
StandardError=append:/home/saunalserver/projects/tidal_auto_monitor/logs/systemd.log

[Install]
WantedBy=multi-user.target
