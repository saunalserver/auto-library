[Unit]
Description=Fetch missing lyrics from LRCLIB for library tracks

[Service]
Type=oneshot
WorkingDirectory=/home/saunalserver/projects/auto-library
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/saunalserver/projects/auto-library/automations/fetch_lyrics.py --limit 400
TimeoutStartSec=1h
Nice=10
