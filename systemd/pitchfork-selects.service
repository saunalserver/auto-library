[Unit]
Description=Pitchfork Selects — download this week's picks and build the Navidrome playlist

[Service]
Type=oneshot
WorkingDirectory=%h/projects/auto-library
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -w 1800 %t/auto-library.lock /usr/bin/python3 %h/projects/auto-library/automations/pitchfork_selects.py
TimeoutStartSec=3h
