[Unit]
Description=Discovery downloads from Last.fm 7-day top artists + similar artists

[Service]
Type=oneshot
WorkingDirectory=/home/saunalserver/projects/auto-library
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -w 1800 %t/auto-library.lock /usr/bin/python3 /home/saunalserver/projects/auto-library/automations/discovery_recommendations.py
TimeoutStartSec=3h
