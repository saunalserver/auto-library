[Unit]
Description=Auto Library monitor (Last.fm scrobbles -> Tidal downloads)

[Service]
Type=oneshot
WorkingDirectory=/home/saunalserver/projects/auto-library
Environment=PYTHONUNBUFFERED=1
# flock: a manual run and the timer can never overlap (double downloads)
ExecStart=/usr/bin/flock -w 1800 %t/auto-library.lock /usr/bin/python3 /home/saunalserver/projects/auto-library/monitor.py
TimeoutStartSec=3h
