[Unit]
Description=Tidal music dedup scanner — fingerprint library + populate findings
After=network.target

[Service]
Type=oneshot
User=saunalserver
WorkingDirectory=/home/saunalserver/projects/tidal_auto_monitor
ExecStart=/usr/bin/python3 /home/saunalserver/projects/tidal_auto_monitor/dedup_tool.py scan
ExecStartPost=/usr/bin/python3 /home/saunalserver/projects/tidal_auto_monitor/dedup_tool.py ntfy-summary
